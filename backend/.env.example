
# Background jobs (due-soon / overdue notices, hold expiry, membership expiry).
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=60

# Optional email for notices. Leave SMTP_HOST empty to keep notices in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Library <no-reply@library.local>

# Set to false to skip the demo catalog/patrons when seeding an empty database.
SEED_DEMO=true
